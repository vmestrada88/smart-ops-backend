# ========================================
# Backend Production Environment (AWS)
# e.g. EC2, ECS, or App Runner + RDS
# ========================================

# Node Environment
NODE_ENV=production

# Server Port
PORT=5000

# ========================================
# Database Configuration
# IMPORTANTE: Usa DATABASE_URL (p. ej. Amazon RDS PostgreSQL)
# ========================================
# DATABASE_URL: definir en AWS (Secrets Manager, SSM, o variables del servicio)
# DATABASE_URL=postgresql://user:password@host:port/database

# Fallback para DB individual (no recomendado, usa DATABASE_URL)
# DB_HOST=your-db.xxxxx.region.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=smartsolution_production
# DB_USER=postgres
# DB_PASSWORD=your-password
DB_SSL=true

# ========================================
# CORS Configuration
# ========================================
FRONTEND_URL=https://smartsolutionfl.com
FRONTEND_URLS=https://smartsolutionfl.com,https://www.smartsolutionfl.com

# ========================================
# JWT Secret
# IMPORTANTE: definir en AWS (Secrets Manager / variables del servicio), nunca en el repo
# ========================================
# JWT_SECRET se inyecta solo en el entorno de ejecución en AWS
# JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
